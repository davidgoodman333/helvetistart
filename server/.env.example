# Swissway backend configuration.
# Everything runs locally — there are NO API keys or external services.
# Copy this file to `.env` only if you want to override a default below.

# Where the local Ollama server listens (default shown):
# OLLAMA_URL=http://localhost:11434

# Which local model to use. Swap this one line to compare models:
#   qwen3:8b                      (default — strong instruction-following)
#   MichelRosselli/apertus:8b-instruct-2509-bf16   (the Swiss model, for comparison)
# OLLAMA_MODEL=qwen3:8b

# Embedding model used to search the sources. bge-m3 (default) is multilingual,
# so English questions also match the German Bern pages. After changing it,
# re-run POST /api/ingest — chunks from another model are ignored until then.
# EMBED_MODEL=bge-m3

# How long Ollama keeps the models loaded between requests (default 30m).
# OLLAMA_KEEP_ALIVE=30m

# Which steps a plan has is decided in code (src/plan-rules.ts); the model only
# writes their text, so its slow reasoning pass is off. Set to true to compare
# with `npm run bench`.
# PLAN_THINK=false

# The model writes one plan step per call. This many are sent at once; Ollama
# answers them one after another unless it was started with
# OLLAMA_NUM_PARALLEL=2 (or more), which makes a not-yet-stored plan faster.
# PLAN_CONCURRENCY=2

# Every step any student can get is written ahead of time, in the background,
# after a start-up or an ingest (a student's own request always goes first).
# Set to false to switch that off, e.g. while testing.
# PLAN_PREWARM=true

# The chat model may call the tools in src/tools.ts (search again, work out a
# date, look up a form or the student's plan). Set to false to switch that off.
# CHAT_TOOLS=true

# How much keyword search counts next to meaning-based search (0 = off).
# Check any change with `npm run eval:retrieval`.
# RETRIEVAL_LEXICAL_WEIGHT=0

# Key facts (src/facts.ts) are extracted from the sources at every ingest.
# A larger model reads the sources more accurately; ingest runs rarely, so it
# can be slower than the chat model. Needs `ollama pull <model>` first.
# EXTRACT_MODEL=qwen3:14b
# The reasoning pass makes extraction more accurate but slow (about a minute
# per fact with qwen3:8b). Set to false for a quick ingest.
# EXTRACT_THINK=true
